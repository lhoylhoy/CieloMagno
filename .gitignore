# ------------------------------------------------------------------------------
# Cielo Magno for Senator 2028 — repository ignores
# Vite + React + TypeScript + Tailwind CSS
# ------------------------------------------------------------------------------

# Dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Build output
dist/
dist-ssr/
build/
*.local

# Vite / bundler caches
.vite/
.cache/
.parcel-cache/
.turbo/

# TypeScript incremental build info
*.tsbuildinfo

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment variables (keep the documented template)
.env
.env.*
.env.local
.env.*.local
!.env.example

# Test / coverage output
coverage/
.nyc_output/

# Linters & formatters
.eslintcache
.stylelintcache
.prettiercache

# Editor and IDE files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
.idea/
*.iml
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS-generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Local deployment tooling (Cloudflare Pages / Netlify / Vercel)
.wrangler/
.netlify/
.vercel/

# Temporary files
*.tmp
*.temp
*.bak
